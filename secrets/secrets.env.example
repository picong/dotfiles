# Copy to ~/.secrets/secrets.env (chmod 600) and fill in real values.
# (复制到 ~/.secrets/secrets.env，权限 600，填入真实值)
# Format: KEY='value' — one per line, single quotes, no spaces around '='.
# (格式：KEY='value'，每行一个，单引号，等号两边不要有空格)
#
# Consumers(使用方):
#   - fish / bash: exported as environment variables (作为环境变量导出)
#   - templates/*.tmpl: ${KEY} placeholders rendered by ./install.sh --render
#     (模板中的 ${KEY} 占位符由 ./install.sh --render 渲染)

# ---- AI gateway (内网 AI 网关) ----
# Base URL of the OpenAI/Anthropic compatible gateway. (兼容网关地址)
AI_GATEWAY_URL='http://gateway.example:3200'
# Gateway key for Claude models — Claude Code / Codex / crush / opencode / pi
GW_KEY_CLAUDE=''
# Gateway key for GPT models — opencode / pi / zed-codex
GW_KEY_GPT=''
# Gateway key for other models (DeepSeek/GLM/Kimi) — opencode / pi
GW_KEY_OTHER=''

# ---- Shell environment (shell 环境变量) ----
OPENAI_API_KEY=''
LOCAL_API_KEY=''
GEMINI_API_KEY=''
# Feishu/Lark open platform app (飞书开放平台应用)
FEISHU_APP_ID=''
FEISHU_APP_SECRET=''
# WeRead agent API key (微信读书)
WEREAD_API_KEY=''
# Local dev database DSN (本地开发数据库)
GREENLIGHT_DB_DSN=''

# ---- Proxy rules (代理规则) ----
# Host that must always connect directly in terminal-adaptive-proxy (始终直连的服务器)
SSW_HOST=''
