model_provider = "OpenAI"
model = "gpt-5.6-sol"
review_model = "gpt-5.5"
model_reasoning_effort = "xhigh"
model_catalog_json = "${HOME}/.codex/model_catalog.json"
disable_response_storage = true
network_access = "enabled"
windows_wsl_setup_acknowledged = true
model_context_window = 400000
model_auto_compact_token_limit = 360000
service_tier = "fast"
approvals_reviewer = "user"
personality = "pragmatic"
approval_policy = "never"

[model_providers.OpenAI]
name = "OpenAI"
base_url = "${AI_GATEWAY_URL}"
wire_api = "responses"
requires_openai_auth = true

[model_providers.GWClaude]
name = "GWClaude"
base_url = "${AI_GATEWAY_URL}"
wire_api = "responses"
experimental_bearer_token = "${GW_KEY_CLAUDE}"

[features]
hooks = true
memories = true
terminal_resize_reflow = true
network_proxy = true
external_migration = true
prevent_idle_sleep = true
js_repl = false

[tui]
vim_mode_default = false
status_line = [
    "model-with-reasoning",
    "project-name",
    "git-branch",
    "context-used",
]
status_line_use_colors = true
pet = "disabled"
theme = "catppuccin-mocha"
screen_reader_detection_done = true

[shell_environment_policy]
inherit = "core"

[shell_environment_policy.set]
ANTHROPIC_AUTH_TOKEN = "${GW_KEY_CLAUDE}"
ANTHROPIC_BASE_URL = "${AI_GATEWAY_URL}"
CLAUDE_CODE_MAX_OUTPUT_TOKENS = "64000"
MAX_THINKING_TOKENS = "31999"
API_TIMEOUT_MS = "600000"
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS = "1"
CLAUDE_CODE_COORDINATOR_MODE = "1"
CLAUDE_CODE_WORKFLOWS = "1"
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC = "1"
CLAUDE_CODE_ATTRIBUTION_HEADER = "0"
BROWSER_USE_AVAILABLE_BACKENDS = "chrome,iab"
NODE_REPL_TRUSTED_BROWSER_CLIENT_SHA256S = "9230e2bd8b24b7ac7a0ba6774c64bf0d78ecdabbdd91d0ed627b02a587bae2df"
NODE_REPL_TRUSTED_CODE_PATHS = "${HOME}/.codex:/usr/lib/chatgpt/resources/cua_node/lib/node_modules"
ENABLE_PROMPT_CACHING_1H = "1"
CODEGRAPH_NO_PROMPT_HOOK = "1"

[mcp_servers.codegraph]
command = "codegraph"
args = ["serve", "--mcp"]

[mcp_servers.github]
url = "https://api.githubcopilot.com/mcp/"
enabled = false

