// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "JetBrains Maple Mono",
  "cli_default_open_behavior": "existing_window",
  // 括号自动闭合要"立刻"出来：
  // 1) use_autoclose 显式打开（输入 ( [ { " 时同一次编辑补上右半边，纯本地无网络）
  // 2) use_on_type_format 关掉，输入时不再等 LSP 的 onTypeFormatting 往返
  // 3) edit_predictions.mode 由 eager 改 subtle，避免每敲一键就同步收集 LSP 上下文
  //    并请求远端网关（日志里 GetEditPredictionTypeDefinitions 每列连发就是它）
  "use_autoclose": true,
  "use_auto_surround": true,
  "use_on_type_format": false,
  "edit_predictions": {
    "mode": "subtle",
    "open_ai_compatible_api": {
      "model": "gpt-5.6-sol",
      "api_url": "http://192.168.1.99:3200"
    },
    "provider": "none"
