// niri 配置 (single-file config)
// KDL 格式: https://kdl.dev  ·  配置文档: https://yalter.github.io/niri/
// "/-" 注释掉紧跟其后的节点 (comments out the following node)
//
// 颜色由 matugen 按壁纸自动生成，写在 noctalia.kdl，本文件末尾 include。
// (colors are auto-generated by matugen into noctalia.kdl, included at the bottom)

config-notification {
    disable-failed
}

gestures {
    hot-corners {
        off
    }
}

// ============================================================
// 输入设备 (Input)  ·  https://yalter.github.io/niri/Configuration:-Input
// ============================================================
input {
    keyboard {
        xkb {
            // 留空则从 org.freedesktop.locale1 读取，可用 localectl set-x11-keymap 控制
            // Caps Lock 映射为 Esc（防误碰）；Shift+Caps 仍可切大写锁定
            options "caps:escape_shifted_capslock"
        }

        // Key repeat, matches previous sway setup; niri defaults are 600/25 which
        // feels sluggish for vim-style j/k navigation
        // (按键重复：与原 sway 配置一致；niri 默认 600/25，vim 式 j/k 移动会明显发滞)
        repeat-delay 300
        repeat-rate 40

        // numlock   // 开机启用 numlock (omit to disable)
    }

    touchpad {
        tap
        natural-scroll

        // 打字时禁用触摸板 (libinput dwt: 按键后约 400ms 内忽略触摸)
        dwt
        // 使用小红点时禁用触摸板
        dwtp
        // 插入外接鼠标时完全禁用触摸板
        disabled-on-external-mouse
    }

    mouse {
    }

    trackpoint {
    }

    // 聚焦窗口时把鼠标移到其中心 (warp mouse to focused window)
    warp-mouse-to-focus
}

// ============================================================
// 显示器 (Outputs)  ·  `niri msg outputs` 查看名称
// ============================================================
// 笔记本内置屏 - 240Hz (built-in laptop display)
output "eDP-1" {
    mode "2560x1440@240.000"
    scale 1.5
    position x=0 y=0
    // variable-refresh-rate
}

// 外接显示器 (external display) — Samsung 支持 71.910Hz，当前用 60Hz
// x must be 1707: eDP-1 logical width is ceil(2560/1.5)=1707, so x=1706 overlaps
// by 1px and niri falls back to automatic placement
// (x 必须是 1707：eDP-1 逻辑宽度为 ceil(2560/1.5)=1707，x=1706 会重叠 1px，niri 会回退到自动摆放)
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    position x=1707 y=0
}

// ============================================================
// 工作区 (Named workspaces)
// ============================================================
// 工作区 1~3 固定笔记本屏，4~9 固定外接屏 (1-3 on laptop, 4-9 on external)
workspace "1" { open-on-output "eDP-1"; }
workspace "2" { open-on-output "eDP-1"; }
workspace "3" { open-on-output "eDP-1"; }
workspace "4" { open-on-output "HDMI-A-1"; }
workspace "5" { open-on-output "HDMI-A-1"; }
workspace "6" { open-on-output "HDMI-A-1"; }
workspace "7" { open-on-output "HDMI-A-1"; }
workspace "8" { open-on-output "HDMI-A-1"; }
workspace "9" { open-on-output "HDMI-A-1"; }

// ============================================================
// 布局 (Layout)  ·  https://yalter.github.io/niri/Configuration:-Layout
// 颜色为 fallback，最终由 noctalia.kdl (matugen) 覆盖
// ============================================================
layout {
    background-color "transparent"
    gaps 4
    center-focused-column "never"

    // Mod+R 在这些预设宽度间切换 (switch-preset-column-width toggles these)
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    border {
        off
        width 2
        active-color   "#cba6f7"      // mauve (强调色)
        inactive-color "#313244"      // surface0 (非活动)
        urgent-color   "#f38ba8"      // red (紧急)
    }
    focus-ring {
        width 2
        active-color   "#cba6f7"      // mauve
        inactive-color "#313244"      // surface0
        urgent-color   "#f38ba8"      // red
    }
    shadow {
        off
        color "#11111b70"             // crust + alpha
    }
    tab-indicator {
        active-color   "#cba6f7"      // mauve
        inactive-color "#6c7086"      // overlay0
        urgent-color   "#f38ba8"      // red
    }
    insert-hint {
        color "#cba6f780"             // mauve + alpha
    }
    struts {
    }
}

overview {
    workspace-shadow {
        off
    }
}

// ============================================================
// 环境变量 (Environment)
// ============================================================
environment {
    // 硬件视频加速指向 Intel 更省电 (VA-API on Intel)
    LIBVA_DRIVER_NAME "iHD"
    // 注意：niri 基于 Smithay，不读 WLR_* 变量（那是 wlroots 的）。
    // 曾在此设置的 WLR_RENDERER / WLR_NO_HARDWARE_CURSORS 均为空操作，已移除。
    // 如需关闭硬件光标平面，用 debug { disable-cursor-plane }
    // Qt 主题走 gtk3 (Qt theme)
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
    // 修复 quickshell 图标主题缺失 (fix missing icon theme)
    QS_ICON_THEME "Adwaita"
    // fcitx 输入法 (input method)
    XMODIFIERS "@im=fcitx"
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    LC_CTYPE "en_US.UTF-8"
    LANG "zh_CN.UTF-8"
    XDG_CURRENT_DESKTOP "niri"
    // 光标主题：给 XWayland / Electron / Wine 等自行读 XCURSOR_* 的程序兜底
    // (cursor theme fallback for clients reading XCURSOR_* themselves)
    XCURSOR_THEME "Bibata-Modern-Ice"
    XCURSOR_SIZE "30"
}

hotkey-overlay {
    skip-at-startup
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// 光标 (Cursor)
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 30
    hide-after-inactive-ms 15000
}

debug {
    // 关闭后：带无效/陈旧 serial 的 xdg-activation 请求被丢弃，不再抢焦点。
    // 这挡住了 browser-harness 通过 CDP (Target.activateTarget / Page.bringToFront)
    // 操作 Chrome 时把焦点抢走的行为。
    // 代价：微信 / 企业微信 / 飞书等点托盘图标或通知也不再能拉起窗口（连 urgent 都不闪），
    // 需要手动切窗（Mod+Tab / Alt+Tab / Mod+数字）。
    // 想恢复旧行为就取消下面这行的注释。
    // (disabled so stale-serial xdg-activation can't steal focus; tray/notification
    //  raise for XWayland chat apps stops working as a side effect)
    // honor-xdg-activation-with-invalid-serial
}

// ============================================================
// 动画 (Animations)  ·  https://yalter.github.io/niri/Configuration:-Animations
// ============================================================
animations {
    // 总体速度，<1 加快 >1 减慢 (overall speed multiplier)
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=0.82 stiffness=523 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.86 stiffness=450 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=750 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

// ============================================================
// 快捷键 (Binds)  ·  https://yalter.github.io/niri/Configuration:-Key-Bindings
// ============================================================
binds {
    // --- 帮助 / 应用启动 (help / launch) ---
    Mod+Shift+Slash hotkey-overlay-title="快捷键教程 Keybind tutorial" { show-hotkey-overlay; }
    Mod+F1 hotkey-overlay-title="开关输入法 Toggle fcitx" { spawn-sh "pkill fcitx5 || fcitx5 "; }
    Mod+F5 hotkey-overlay-title="快速存档 Quick save" { spawn "quicksave"; }
    Mod+F8 hotkey-overlay-title="快速读档 Quick load" { spawn "quickload"; }

    // 临时浮动终端 (quick floating terminal)
    Mod+Slash hotkey-overlay-title="临时终端 Quick Terminal" { spawn "kitty" "--single-instance" "--class" "quickterminal"; }
    Mod+B hotkey-overlay-title="浏览器 Browser" { spawn "zen-browser"; }
    Mod+T hotkey-overlay-title="终端 Terminal" { spawn "kitty" "--single-instance"; }
    Mod+F2 hotkey-overlay-title="控制中心 Control Center" { spawn "~/.local/bin/control-center"; }

    // Noctalia 面板 — 官方 IPC 切换 (Noctalia panels via IPC)
    Mod+P hotkey-overlay-title="Noctalia Media Panel" { spawn-sh "noctalia msg panel-toggle control-center media"; }
    Mod+Shift+C hotkey-overlay-title="Noctalia Control Center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+F3 hotkey-overlay-title="录屏 Screen record" { spawn "~/.local/bin/wf-recorder-menu"; }

    // 文件管理器：优先 thunar，回退 nautilus (file manager)
    Mod+E hotkey-overlay-title="文档管理器 Filemanager" { spawn-sh "thunar || env GSK_RENDERER=gl GTK_IM_MODULE=fcitx  nautilus"; }
    Mod+Alt+E hotkey-overlay-title=null { spawn "env" "GSK_RENDERER=gl" "GTK_IM_MODULE=fcitx" "nautilus" "--new-window"; }
    Mod+Space hotkey-overlay-title="Noctalia 程序启动器 Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Alt+W hotkey-overlay-title="Noctalia 壁纸选择器 Wallpaper" { spawn-sh "noctalia msg panel-toggle wallpaper"; }

    // --- 总览 / 关窗 (overview / close) ---
    Mod+O hotkey-overlay-title="切换总览界面 toggle overview" repeat=false { toggle-overview; }
    Mod+G repeat=false { toggle-overview; }
    Mod+Q hotkey-overlay-title="关闭聚焦窗口 Close focus window" repeat=false { close-window; }
    Alt+F4 hotkey-overlay-title=null repeat=false { close-window; }
    Mod+MouseMiddle { close-window; }

    // --- 切换聚焦 (focus) ---
    Mod+Left hotkey-overlay-title=null { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-right; }

    // --- 移动列 (move column) ---
    Mod+Ctrl+Left hotkey-overlay-title=null { move-column-left; }
    Mod+Ctrl+Right hotkey-overlay-title=null { move-column-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-column-to-workspace-down; }
    Mod+Ctrl+K { move-column-to-workspace-up; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+A { move-column-left; }
    Mod+Ctrl+D { move-column-right; }
    Mod+S { move-window-down; }
    Mod+W { move-window-up; }

    // 首列 / 末列 (first / last column)
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }

    // --- 跨显示器聚焦 (focus monitor) ---
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+J { focus-monitor-down; }
    Mod+Shift+K { focus-monitor-up; }
    Mod+Shift+L { focus-monitor-right; }

    // --- 跨显示器移动列 (move column to monitor) ---
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+A { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+S { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+W { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+D { move-column-to-monitor-right; }

    // --- 整个工作区移到另一显示器 (move workspace to monitor) ---
    Mod+Shift+Alt+W { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+S { move-workspace-to-monitor-down; }
    Mod+Shift+Alt+D { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+A { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+K { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+J { move-workspace-to-monitor-down; }
    Mod+Shift+Alt+L { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+H { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+Up { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+Down { move-workspace-to-monitor-down; }
    Mod+Shift+Alt+Right { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+Left { move-workspace-to-monitor-left; }

    // --- 滚轮切换工作区 / 聚焦 (wheel: workspace / focus) ---
    Mod+Shift+WheelScrollDown hotkey-overlay-title="切换工作区 Change workspaces" cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollDown hotkey-overlay-title="滚轮切换聚焦 Change focus with wheel" { focus-column-right; }
    Mod+WheelScrollUp { focus-column-left; }
    Mod+Ctrl+WheelScrollDown { move-column-right; }
    Mod+Ctrl+WheelScrollUp { move-column-left; }

    // --- 窗口在列间移动 / 合并 (consume / expel) ---
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+A hotkey-overlay-title="向左移动窗口 Move window to left between columes" { consume-or-expel-window-left; }
    Mod+D hotkey-overlay-title="向右移动窗口 Move window to right between columes" { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+Shift+A { consume-window-into-column; }
    Mod+Shift+D { expel-window-from-column; }

    // 标签页模式 (tabbed column)
    Mod+Shift+X { toggle-column-tabbed-display; }
    Mod+X { toggle-column-tabbed-display; }
    // 鼠标侧键上下切换聚焦 (mouse side buttons)
    Mod+MouseForward { focus-window-up; }
    Mod+MouseBack { focus-window-down; }

    // --- 窗口尺寸 (window size) ---
    Mod+R hotkey-overlay-title="按预设切换宽度 Switch width " { switch-preset-window-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    // 会议窗口走 xdotool 缩放，普通窗口回退 niri (meeting via xdotool, others fall back)
    Mod+F hotkey-overlay-title="最大化 maximize" { spawn "~/.config/niri/shorin-niri/scripts/meeting-resize.sh" "max"; }
    Mod+Alt+F hotkey-overlay-title="全屏 fullscreen" { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { spawn "~/.config/niri/shorin-niri/scripts/meeting-resize.sh" "narrower"; }
    Mod+Equal { spawn "~/.config/niri/shorin-niri/scripts/meeting-resize.sh" "wider"; }
    Mod+Shift+Minus { spawn "~/.config/niri/shorin-niri/scripts/meeting-resize.sh" "shorter"; }
    Mod+Shift+Equal { spawn "~/.config/niri/shorin-niri/scripts/meeting-resize.sh" "taller"; }

    // --- 浮动 (floating) ---
    Mod+V hotkey-overlay-title="切换浮动 Toggle floating" { toggle-window-floating; }
    Mod+Shift+V hotkey-overlay-title=null { switch-focus-between-floating-and-tiling; }
    Mod+N hotkey-overlay-title="切换浮动聚焦 Change focus to floating" { switch-focus-between-floating-and-tiling; }
    Alt+grave hotkey-overlay-title=null { switch-focus-between-floating-and-tiling; }
    Mod+Alt+N hotkey-overlay-title=null { switch-focus-between-floating-and-tiling; }

    // --- 截图 (screenshot) ---
    Mod+Alt+A hotkey-overlay-title="选取区域截图 Select screenshot" { spawn-sh "niri msg action screenshot --show-pointer false && pkill -f -USR1 screenshot-sound.sh"; }
    Mod+Alt+Ctrl+A hotkey-overlay-title="截取聚焦窗口 Focus-window screenshot" { spawn-sh "niri msg action screenshot-window && pkill -f -USR1 screenshot-sound.sh"; }
    Mod+Alt+Ctrl+Shift+A hotkey-overlay-title="截取显示器 Monitor screenshot" { spawn-sh "niri msg action screenshot-screen --show-pointer false && pkill -f -USR1 screenshot-sound.sh"; }
    Print hotkey-overlay-title=null { spawn-sh "niri msg action screenshot --show-pointer false && pkill -f -USR1 screenshot-sound.sh"; }
    Ctrl+Print hotkey-overlay-title=null { spawn-sh "niri msg action screenshot-window --show-pointer false && pkill -f -USR1 screenshot-sound.sh"; }
    Shift+Print hotkey-overlay-title=null { spawn-sh "niri msg action screenshot-screen --show-pointer false && pkill -f -USR1 screenshot-sound.sh"; }
    Mod+Shift+S hotkey-overlay-title="截图后按下此键进行编辑 Edit the image after screenshot" { spawn-sh "wl-paste | satty -f -"; }

    // 粘贴图片到 Wine 应用 (paste image to Wine apps)
    Mod+Alt+Shift+V hotkey-overlay-title="粘贴图片到Wine Paste image to Wine" { spawn-sh "wine-paste-image"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E hotkey-overlay-title="退出niri Quit niri" { quit; }

    // --- 系统组件 (system components) ---
    Mod+M hotkey-overlay-title="Task Manager" { spawn "ghostty" "-e" "btop"; }
    Super+X hotkey-overlay-title="Power Menu: Toggle" { spawn "~/.local/bin/power-menu"; }
    Mod+Y hotkey-overlay-title="Noctalia 壁纸选择器 Wallpaper" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Alt+V hotkey-overlay-title="Noctalia 剪贴板 Clipboard" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Alt+L hotkey-overlay-title="锁屏 Lock Screen" { spawn-sh "noctalia msg session lock"; }
    Mod+Alt+P hotkey-overlay-title="挂起 Suspend" { spawn-sh "noctalia msg session lock && niri msg action power-off-monitors && systemctl suspend"; }
    Ctrl+Alt+Delete hotkey-overlay-title="任务管理器 Task Manager" { spawn "ghostty" "-e" "btop"; }

    // --- 媒体控制 → Noctalia IPC (media keys) ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // --- 工作区导航 (workspace navigation) ---
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+I { move-workspace-up; }

    // 数字工作区 (numbered workspaces)
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+6 { focus-workspace "6"; }
    Mod+7 { focus-workspace "7"; }
    Mod+8 { focus-workspace "8"; }
    Mod+9 { focus-workspace "9"; }
    Mod+Ctrl+1 { move-column-to-workspace "1"; }
    Mod+Ctrl+2 { move-column-to-workspace "2"; }
    Mod+Ctrl+3 { move-column-to-workspace "3"; }
    Mod+Ctrl+4 { move-column-to-workspace "4"; }
    Mod+Ctrl+5 { move-column-to-workspace "5"; }
    Mod+Ctrl+6 { move-column-to-workspace "6"; }
    Mod+Ctrl+7 { move-column-to-workspace "7"; }
    Mod+Ctrl+8 { move-column-to-workspace "8"; }
    Mod+Ctrl+9 { move-column-to-workspace "9"; }

    // 备用截图 / 关显示器 (spare screenshot / monitor off)
    XF86Launch1 { screenshot; }
    Ctrl+XF86Launch1 { screenshot-screen; }
    Alt+XF86Launch1 { screenshot-window; }
    Mod+Shift+P { power-off-monitors; }
}

// ============================================================
// 带缩略图的切窗器 (recent-windows / alt-tab)
// Super+Tab 是刻意设的切窗器，勿改 (intentional switcher, do not touch)
// ============================================================
recent-windows {
    debounce-ms 750
    open-delay-ms 150

    highlight {
        padding 30
        corner-radius 0
        active-color   "#cba6f7"   // mauve
        urgent-color   "#f38ba8"   // red
    }
    previews {
        max-height 480
        max-scale 0.2
    }
    binds {
        // Super+Tab 组：当前工作区/应用内切窗 (workspace/app scope)
        Mod+Tab         { next-window scope="workspace"; }
        Mod+Shift+Tab   { previous-window scope="workspace"; }
        Mod+grave       { next-window filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
        // Alt+Tab 组：当前显示器切窗 (output scope) — 覆盖默认 super+tab
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

// ============================================================
// 层规则 (Layer rules)
// ============================================================
// quickshell 面板不放进 backdrop (keep quickshell panels above backdrop)
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop false
}
// swww 壁纸置于 niri backdrop，供 overview 显示 (wallpaper into backdrop)
layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

// ============================================================
// 窗口规则 (Window rules)  ·  https://yalter.github.io/niri/Configuration:-Window-Rules
// ============================================================

// 全局圆角/裁剪默认 (global corner-radius & clip defaults)
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}

// 指定应用不透明 (opaque for specific apps)
// Opacity and blur both disabled: translucency forces the compositor to blend
// against what is behind the window, and blur adds another pass per frame on the
// 240Hz output, which hurts redraw-heavy apps like IDEA
// (透明和模糊均已关闭：半透明迫使合成器与窗口后方内容做混合，
//  模糊在 240Hz 屏上又多一道 pass，拖累 IDEA 等重绘密集应用)
window-rule {
    match app-id="code"
    match app-id="kitty"
    match app-id="clash-verge"
    match app-id=r#"^[Dd][Bb]eaver"#
    match app-id=r#"^jetbrains"#
    opacity 0.9
    draw-border-with-background false
    background-effect {
        blur true
    }
}

// 终端类：不画背景边框、方角、裁剪 (terminals)
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
    geometry-corner-radius 0
    clip-to-geometry true
}

// WezTerm 初始 configure bug 处理 (workaround for wezterm)
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// GNOME 应用 (GNOME apps)
window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
    geometry-corner-radius 0
    clip-to-geometry true
}

// 设置类窗口：半宽平铺 (settings-like, tiled half-width)
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}

// 小工具类：浮动并聚焦 (small utilities, floating + focused)
window-rule {
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^xdg-desktop-portal$"#
    match app-id=r#"^hyprland-share-picker$"#
    open-floating true
    open-focused true
}

// Steam 通知气泡 (steam notification toasts)
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// zen 浏览器占满宽度 (zen full width)
window-rule {
    match app-id="zen"
    default-column-width { proportion 1.0; }
}

// 画中画 / zoom 浮动 (PiP / zoom floating)
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}

// imv 图片预览：浮动、不自动聚焦 (imv floating, not focused)
window-rule {
    match app-id="imv"
    open-focused false
    open-floating true
}

// shorinclip 剪贴板 TUI (clipboard TUI)
window-rule {
    match app-id="shorinclip"
    default-column-width { fixed 625; }
    default-window-height { fixed 700; }
    open-floating true
    default-floating-position x=0 y=18 relative-to="top"
}

// 各类浮动应用 (assorted floating apps)
window-rule {
    match app-id="com.gabm.satty"
    match app-id="media_info"
    match app-id="video2gif"
    match app-id="floating-term"
    match app-id="nm-connection-editor"
    match app-id="niri-quick-switch"
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="steam" title="Friends List"
    match app-id="blueberry.py" title="蓝牙"
    match app-id="blueman-manager"
    match app-id="flameshot"
    match app-id="com.github.hluk.copyq"
    match app-id="be.alexandervanhee.gradia"
    match app-id="org.pulseaudio.pavucontrol" title="音量控制"
    match app-id="org.gnome.clocks" title="时钟"
    match app-id="fcitx" title="Fcitx5 Input Window"
    match app-id="org.gnome.FileRoller"
    match app-id="thunar" title="文件操作进度"
    match app-id="waypaper"
    match app-id="clipse-gui"
    match title="群聊的聊天记录"
    match title="聊天记录"
    match title="日历"
    match title="重命名"
    match app-id="btrfs-assistant"
    match app-id="markpix"
    match title="Steam 设置"
    match title="另存为"
    match app-id="better_control.py"
    open-floating true
}

// 快速终端 (quick terminal)
window-rule {
    match app-id="quickterminal"
    open-floating true
    default-floating-position x=20 y=20 relative-to="top"
}

// bluetui / impala TUI (定宽浮动)
window-rule {
    match app-id="bluetui"
    match app-id="impala"
    default-column-width { fixed 800; }
    default-window-height { fixed 800; }
    open-floating true
}

// clipse 剪贴板 TUI
window-rule {
    match app-id="clipse"
    default-column-width { fixed 625; }
    default-window-height { fixed 700; }
    open-floating true
}

// waydroid 全屏浮动、无边框阴影 (waydroid fullscreen floating)
window-rule {
    match title="gsr ui"
    match app-id="waydroid"
    open-fullscreen true
    open-floating true
    focus-ring {
        off
    }
    shadow {
        off
    }
}

// 图片/视频预览：不透明并浮动 (image/video viewers opaque + floating)
window-rule {
    match title="图片查看器"
    match title="画中画"
    match title="图片和视频"
    match title="视频播放器"
    open-floating true
    opacity 1.0
}
window-rule {
    match app-id="mpv"
    match app-id="celluloid"
    opacity 1.0
}

// Zed：保持不透明、不模糊、无背景边框 (Zed opaque, no blur)
window-rule {
    match app-id=r#"^dev\.zed\.Zed$"#
    opacity 1.0
    draw-border-with-background false
    background-effect {
        blur false
    }
}

// --- Wine / 企业微信 (WXWork) ---
window-rule {
    match app-id="wine"
    draw-border-with-background false
}
window-rule {
    match title=r#"企业微信$"#
    draw-border-with-background false
}
// 企业微信主窗口平铺，仅弹窗浮动 (main window tiled, popups float)
window-rule {
    match app-id="com.qq.weixin.work.deepin"
    exclude title="^企业微信$"
    open-floating true
    open-fullscreen false
}
// 隐藏 Wine 托盘窗口 (hide Wine system tray)
window-rule {
    match title="Wine System Tray"
    opacity 0.0
}
// 企业微信通用对话框浮动 (WXWork common dialogs float)
window-rule {
    match title="选择聊天对象"
    match title="发送给"
    match title="确认"
    match title="提示"
    match title="警告"
    match title="设置"
    open-floating true
    draw-border-with-background false
}
window-rule {
    match title="登录"
    match title="更新"
    match title="文件传输"
    match title="视频通话"
    match title="语音通话"
    match title="群公告"
    match title="红包"
    match title="日程提醒"
    match title="审批"
    match title="通知"
    match title="错误"
    match title="权限"
    match title="截图"
    match title="新建"
    match title="编辑"
    match title="删除"
    match title="退出"
    match title="注销"
    match title="表情"
    match title="选择表情"
    open-floating true
    draw-border-with-background false
}
// 企业微信无标题弹窗（表情选择器等） (WXWork titleless popups, AND match)
window-rule {
    match app-id="com.qq.weixin.work.deepin" title=r#"^$"#
    open-floating true
    draw-border-with-background false
}

// quickshell 窗口默认浮动 (quickshell windows float)
window-rule {
    match app-id=r#"org.quickshell$"#
    open-floating true
}

// Android 模拟器固定到专用工作区 9，避免浮动工具栏压住企业微信
// (pin emulator to workspace 9 so its floating toolbar has no neighbor)
window-rule {
    match app-id="Emulator"
    open-on-workspace "9"
}

// ============================================================
// 开机启动 (Startup)
// ============================================================
// Noctalia v5 shell：接管顶栏 / OSD / 通知 / 面板 / 壁纸 / 剪贴板
// (Noctalia owns bar, OSD, notifications, panels, wallpaper, clipboard)
spawn-at-startup "noctalia"

spawn-at-startup "xhost" "+si:localuser:root"
spawn-at-startup "fcitx5" "-d"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
// niri 使用非 KDE portal，避免腾讯会议无法启动/参会
spawn-at-startup "~/.local/bin/switch-desktop-portal"
spawn-at-startup "~/.config/niri/shorin-niri/scripts/screenshot-sound.sh"
// The WeCom launcher runs a bounded readiness probe; no persistent polling. (企业微信启动器运行有限时长的就绪探测，不做常驻轮询。)
// 自动把腾讯会议语音悬浮条挪到屏幕外 (auto-hide Tencent Meeting voice bar)
spawn-at-startup "~/.config/niri/shorin-niri/scripts/meeting-voicebar-hide.sh"
// 隐藏安卓模拟器独立侧边工具栏 (hide Android Emulator side toolbar)
spawn-at-startup "~/.config/niri/shorin-niri/scripts/hide-emulator-toolbar.sh"

// ============================================================
// 颜色覆盖 (Color overrides)
// noctalia.kdl 由 matugen 按壁纸自动生成，勿手改 (auto-generated by matugen)
// ============================================================
include "./noctalia.kdl"
